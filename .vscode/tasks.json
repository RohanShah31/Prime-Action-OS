{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run PrimeActionOS (Backend + Frontend)",
      "dependsOn": ["Start FastAPI Backend", "Start Next.js Frontend"],
      "problemMatcher": []
    },
    {
      "label": "Start FastAPI Backend",
      "type": "shell",
      "command": "uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "servers",
        "panel": "shared"
      }
    },
    {
      "label": "Start Next.js Frontend",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "servers",
        "panel": "shared"
      }
    }
  ]
}
